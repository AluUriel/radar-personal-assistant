# Advanced runtime overrides only. Normal setup happens in Radar's Connections panel;
# do not copy this file unless you are deliberately bypassing the local settings UI.
# Identity is verified before every first sync. Do not assume an account from this value alone.
RADAR_OWNER_EMAIL=owner@meticuloushome.com
RADAR_INGEST_SECRET=
RADAR_URL=http://localhost:3000
# Only set true for a disposable local demo. Real source sync never needs demo data.
RADAR_SEED_SYNTHETIC_DEMO=false
RADAR_SYNC_INTERVAL_MINUTES=15
# Optional comma-separated subset: slack,gmail,discord. Empty means every configured source.
RADAR_SYNC_SOURCES=

# Local Obsidian collector. The collector is read-only.
OBSIDIAN_VAULT_PATH=C:\path\to\your\vault
OBSIDIAN_SCOPE_PATH=.radar-data\obsidian-scope.approved.json
# Nested Git repositories remain excluded unless both the approved scope includes them and this is true.
OBSIDIAN_INCLUDE_NESTED_REPOS=false

# Existing read-only Discord knowledge service.
DISCORD_MCP_URL=https://your-discord-knowledge-service.example/mcp
DISCORD_MCP_API_KEY=
DISCORD_OWNER_USER_ID=
DISCORD_OWNER_QUERY=
# Zero means the complete archive and an unlimited adaptive search budget.
DISCORD_LOOKBACK_DAYS=0
DISCORD_MAX_SEARCH_REQUESTS=0

# Slack OAuth or bot credentials with an explicitly reviewed read-only scope set.
SLACK_ACCESS_TOKEN=
# Zero means exhaustive collection. Positive values are diagnostic limits and make coverage partial.
SLACK_LOOKBACK_DAYS=0
SLACK_MAX_CHANNELS=0
SLACK_MAX_THREADS=0

# Gmail OAuth credentials. Intercom email is selected with a Gmail query, not a second mailbox copy.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=in:anywhere -in:spam -in:trash
INTERCOM_GMAIL_QUERY=from:intercom
# Zero means exhaustive collection. A positive value is a diagnostic cap and makes coverage partial.
GMAIL_MAX_THREADS=0

# Local text-only sidecar. TEXT_GENERATOR_API_KEY and SIDECAR_SHARED_SECRET must match.
TEXT_GENERATOR_URL=http://127.0.0.1:8789/draft
TEXT_GENERATOR_API_KEY=
SIDECAR_SHARED_SECRET=
SIDECAR_PORT=8789
SIDECAR_HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
